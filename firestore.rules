rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== STORE RULES (existing) =====
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /referrers/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /referralSales/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /music/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /shorts/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update: if request.auth != null;
    }
    match /wallets/{phone} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /spinWinners/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /spinReferrals/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /coinPurchases/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /reviews/{id} {
      allow read: if resource.data.approved == true || request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // ===== GAME RULES (new) =====
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['balls']);

      // Each user's own friends list — only they can read/write it
      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /transactions/{txId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /gameSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gameMusic/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Group chat — any signed-in player (including anonymous accounts) can read/post
    match /groupChat/{docId} {
      allow read, write: if request.auth != null;
    }

    // Direct messages — dmId is formed as "uid1_uid2" (sorted), so only the
    // two participants can access their own conversation.
    function isDmParticipant(dmId) {
      return request.auth != null &&
        (dmId.split('_')[0] == request.auth.uid || dmId.split('_')[1] == request.auth.uid);
    }
    match /dms/{dmId} {
      allow read, write: if isDmParticipant(dmId);
      match /messages/{msgId} {
        allow read, write: if isDmParticipant(dmId);
      }
    }

    // Challenge Friend rooms — any signed-in player can create/read/join;
    // WebRTC signaling messages live in the signal subcollection.
    match /matches/{matchId} {
      allow read, write: if request.auth != null;
      match /signal/{sigId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
